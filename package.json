{
  "name": "lumen",
  "version": "1.4.0",
  "description": "A beautiful, tiling, extensible terminal",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist:mac": "electron-builder --mac",
    "pack": "electron-builder --dir"
  },
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@fontsource/cascadia-code": "^5.3.0",
    "@fontsource/commit-mono": "^5.3.0",
    "@fontsource/fira-code": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/intel-one-mono": "^5.3.0",
    "@fontsource/iosevka": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/martian-mono": "^5.3.0",
    "@fontsource/monaspace-neon": "^5.3.0",
    "@fontsource/source-code-pro": "^5.3.1",
    "@fontsource/space-mono": "^5.3.0",
    "@fontsource/victor-mono": "^5.3.0",
    "@lydell/node-pty": "^1.2.0-beta.18",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "productName": "Lumen",
  "author": {
    "name": "Lumen contributors",
    "email": "lumen@users.noreply.github.com"
  },
  "build": {
    "appId": "dev.lumen.terminal",
    "productName": "Lumen",
    "copyright": "MIT License",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "builtin-plugins/**/*",
      "defaults/**/*",
      "package.json",
      "!**/*.map",
      "!node_modules/@fontsource/*/files/*.woff",
      "!node_modules/@fontsource/*/files/*-latin-ext-*",
      "!node_modules/@fontsource/*/files/*-cyrillic*",
      "!node_modules/@fontsource/*/files/*-greek*",
      "!node_modules/@fontsource/*/files/*-vietnamese*",
      "!node_modules/@fontsource/*/files/*-math*",
      "!node_modules/@fontsource/*/files/*-symbols*",
      "!node_modules/**/{README,CHANGELOG,HISTORY}*",
      "!node_modules/**/*.d.ts",
      "!node_modules/**/*.d.mts",
      "assets/icon.png",
      "assets/icon.ico",
      "assets/icon-1024.png"
    ],
    "asarUnpack": [
      "node_modules/@lydell/**",
      "src/main/mcp-server.js",
      "src/main/ai-tools.js"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "Lumen-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Lumen",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "uninstallDisplayName": "Lumen",
      "deleteAppDataOnUninstall": false
    },
    "electronLanguages": [
      "en-US",
      "fr"
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon-1024.png",
      "category": "System;TerminalEmulator",
      "synopsis": "A tiling terminal that feels alive",
      "description": "Lumen is an open-source tiling terminal: workspaces, live themes, animated backgrounds, command blocks and plugins in plain JavaScript.",
      "executableName": "lumen",
      "artifactName": "Lumen-${version}-${arch}.${ext}",
      "desktop": {
        "entry": {
          "StartupWMClass": "Lumen",
          "Keywords": "terminal;shell;console;tiling;"
        }
      },
      "syncDesktopName": true
    },
    "deb": {
      "maintainer": "Lumen contributors <lumen@users.noreply.github.com>"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "assets/icon-1024.png",
      "category": "public.app-category.developer-tools",
      "artifactName": "Lumen-${version}-${arch}.${ext}",
      "darkModeSupport": true,
      "identity": null
    },
    "dmg": {
      "title": "Lumen ${version}"
    }
  },
  "homepage": "https://github.com/D4L1IR3Tr0/lumen-terminal",
  "desktopName": "lumen.desktop",
  "repository": {
    "type": "git",
    "url": "https://github.com/D4L1IR3Tr0/lumen-terminal.git"
  },
  "bugs": {
    "url": "https://github.com/D4L1IR3Tr0/lumen-terminal/issues"
  }
}
